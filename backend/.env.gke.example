# ─────────────────────────────────────────────────────────────────────────────
# GKE TPU backend — configuration template
#
# Copy to `backend/.env` (gitignored) and fill in your values, then deploy:
#   MODAL_APP_NAME=<app> MODAL_ENVIRONMENT=<env> uv run modal deploy deploy.py
#
# Every knob below is a pydantic Setting read at startup (prefix ODDISH_).
# Only PROJECT_ID + REGION + the two REGISTRY_* values are required to turn
# the backend on; the rest have safe defaults shown in [brackets]. Values
# here are examples — replace <…> placeholders.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required: turning the backend on ────────────────────────────────────────
# Setting PROJECT_ID registers the GKE backend and makes `--env gke` available.
ODDISH_GKE_PROJECT_ID=<your-gcp-project-id>
ODDISH_GKE_REGION=<region>                     # must serve your provisioning mode (see below)

# Artifact Registry Docker repo that holds the built task images.
ODDISH_GKE_REGISTRY_LOCATION=<region>          # usually the same as ODDISH_GKE_REGION
ODDISH_GKE_REGISTRY_NAME=<artifact-registry-repo>   # e.g. oddish-envs

# ── Optional: naming ────────────────────────────────────────────────────────
# Cluster name. Leave UNSET to derive "<MODAL_APP_NAME>-trials" (recommended —
# each deployment gets its own cluster, reaped independently). Set only to pin
# a specific pre-existing cluster.
# ODDISH_GKE_CLUSTER_NAME=my-cluster           # [derived: <MODAL_APP_NAME>-trials]

# Kubernetes namespace for trial pods (auto-created).
# ODDISH_GKE_NAMESPACE=oddish-trials           # [oddish-trials]

# ── Optional: provisioning & capacity ───────────────────────────────────────
# Create the cluster + namespace on demand if missing (zero-touch). Set false
# to require a pre-existing cluster (the deploy then hard-checks it exists).
# ODDISH_GKE_AUTO_PROVISION_CLUSTER=true        # [true]

# Delete the platform-created cluster after this many idle hours (the reaper).
# 0 disables the reaper (cluster stands until manually removed).
# ODDISH_GKE_IDLE_CLUSTER_TTL_HOURS=3           # [3]

# Provisioning mode for ACCELERATOR pods (TPU/GPU). CPU pods always use
# standard provisioning regardless of this setting. One name, three values:
#
#   flex-start  queues for capacity, held up to 7 days, never reclaimed.
#               Served in only a few zones per accelerator generation.
#   spot        no queue: capacity now or nothing, reclaimable at any time.
#               Reaches every zone the generation exists in -- reachability,
#               not quota, is its advantage (preemptible accelerator quota is
#               a per-zone default applied to every zone equally).
#   on-demand   needs standard quota, separate from the preemptible pool the
#               other two draw on.
#
# ODDISH_GKE_REGION has to serve the mode you picked; flex-start zones are the
# narrowest set, so a region spot can reach may still refuse flex-start.
# ODDISH_GKE_PROVISIONING_MODE=flex-start       # [flex-start] on-demand|spot|flex-start

# How long a pod may sit Pending waiting for capacity (billing-free while
# Pending). Flex-start queues can be long; lower it for CPU-only work to fail
# faster (e.g. 900).
# ODDISH_GKE_POD_READY_TIMEOUT_SEC=3600         # [3600]

# ── Optional: image building ────────────────────────────────────────────────
# Worker-side fallback that builds a missing task image inside the trial. The
# PRIMARY build path (at task upload) runs regardless; this only covers the
# race where a worker claims a trial before the upload-time build finishes.
# Recommended true on hosted deployments so nothing waits on an operator.
# ODDISH_GKE_AUTO_BUILD_MISSING_IMAGE=false      # [false]
