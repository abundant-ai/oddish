# =============================================================================
# Required
# =============================================================================
ODDISH_DATABASE_URL=postgresql+asyncpg://postgres.[project-ref]:[db-password]@[host]:[port]/[database]

# Clerk domain used for JWT verification (JWKS)
ODDISH_HARBOR_ENVIRONMENT=modal
ODDISH_API_HOST=0.0.0.0
ODDISH_API_PORT=8000

# Required to validate incoming Clerk webhooks (/webhooks/clerk)
CLERK_DOMAIN=verified-osprey-29.clerk.accounts.dev
CLERK_WEBHOOK_SECRET==
# Optional explicit JWT issuer override (defaults to https://CLERK_DOMAIN)
# CLERK_ISSUER=

# Optional audience enforcement for Clerk JWTs
# CLERK_JWT_AUDIENCE=


# =============================================================================
# Required runtime/storage settings (ODDISH_* from oddish core settings)
# =============================================================================
ODDISH_S3_BUCKET=data
ODDISH_S3_REGION=us-east-1
ODDISH_S3_ACCESS_KEY=...
ODDISH_S3_SECRET_KEY=...
ODDISH_S3_ENDPOINT_URL=...

# When agent-sandbox-service is configured (ODDISH_AGENT_SANDBOX_SERVICE_URL),
# trajectory summaries are generated by the service. The service uses the
# SAME ODDISH_S3_* bucket for the trajectory_summary.json cache, so no
# additional storage configuration is needed beyond rotating credentials.
# AGENT_SANDBOX_S3_* on the service should match these values.

# =============================================================================
# LLM/Sandbox provider keys
# =============================================================================
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# AWS_BEARER_TOKEN_BEDROCK=
# DAYTONA_API_KEY=

# GitHub integration (task/experiment PR refresh endpoints)
# GITHUB_TOKEN=

# Optional CORS allowlist, comma-separated
# CORS_ALLOWED_ORIGINS=http://localhost:3000,https://www.oddish.app

# Optional dashboard URL used by GitHub notifier links
# ODDISH_DASHBOARD_URL=https://www.oddish.app

# Agent-sandbox-service (cc-chat proxy target)
ODDISH_AGENT_SANDBOX_SERVICE_URL=
ODDISH_AGENT_SANDBOX_SERVICE_API_KEY=
