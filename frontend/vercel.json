{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/oddish.py": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "../{backend/**/*.py,backend/**/*.ini,backend/**/*.toml,oddish/src/**/*.py,oddish/pyproject.toml}"
    }
  },
  "rewrites": [
    {
      "source": "/py-api/:path*",
      "destination": "/api/oddish"
    }
  ]
}
