# =============================================================================
# Clerk Authentication (Required)
# =============================================================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk JWT template for backend auth
CLERK_JWT_TEMPLATE=oddish

# =============================================================================
# Backend API
# =============================================================================
# Local development:
#   - Run the API with ``cd backend && uv run uvicorn serve:api --port 8000``
#     OR with ``vercel dev`` (which spins up ``frontend/api/oddish.py``
#     on the same port as Next.js and routes ``/py-api/*`` correctly).
#   - With uvicorn at port 8000, set NEXT_PUBLIC_API_URL=http://localhost:8000.
#   - With ``vercel dev``, leave NEXT_PUBLIC_API_URL unset so the
#     resolver in ``src/lib/backend-config.ts`` falls through to
#     ``$VERCEL_URL/py-api`` (or you can set it explicitly to
#     ``http://localhost:3000/py-api``).
#
# Vercel preview / production:
#   - Leave unset. The resolver auto-builds ``https://$VERCEL_URL/py-api``
#     so the proxy routes hit the *same* Vercel deployment as the
#     frontend bundle that issued the request -- this is what makes
#     deploys atomic and kills the frontend/backend version skew that
#     used to cause outages during rollouts.
NEXT_PUBLIC_API_URL=http://localhost:8000

# =============================================================================
# Optional App & Clerk Redirect Overrides
# =============================================================================
# App base URL for absolute Clerk redirects (useful for local HTTPS flows)
# NEXT_PUBLIC_APP_URL=https://local.oddish.app
# NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
# NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
