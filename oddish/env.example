##### Database (required)
ODDISH_DATABASE_URL=postgresql+asyncpg://oddish:oddish@HOST:5432/oddish

##### LLM API Keys
ANTHROPIC_API_KEY=...
# Separate Anthropic key for --model anthropic-hdo/<claude-model>. Injected as
# ANTHROPIC_API_KEY for that trial (overwriting the platform key) so Claude
# Code talks to the direct Anthropic API with this credential instead of
# Bedrock / ANTHROPIC_API_KEY.
ANTHROPIC_HDO_API_KEY=...
GEMINI_API_KEY=...
# z.ai / GLM auth token, used by GLM models on the claude-code harness
# (e.g. --model zai/glm-x-preview[1m]). Optionally override the endpoint
# via ZAI_BASE_URL (default https://api.z.ai/api/anthropic).
ZAI_API_KEY=...
# MiniMax auth token, used by MiniMax M-series models on the claude-code
# harness (e.g. --model minimax/MiniMax-M3). Optionally override the endpoint
# via MINIMAX_BASE_URL (default https://api.minimax.io/anthropic).
MINIMAX_API_KEY=...
# Moonshot auth token, used by Kimi K2.7 Code on the claude-code harness
# (e.g. --model moonshot/kimi-k2.7-code). Optionally override the endpoint
# via MOONSHOT_BASE_URL (default https://api.moonshot.ai/anthropic).
MOONSHOT_API_KEY=...
# Fireworks auth token. The consolidation route for GLM / MiniMax / Kimi (and
# other open models) on the claude-code harness via Fireworks' single
# Anthropic-compatible endpoint (e.g. --model fireworks/glm-5.2,
# fireworks/minimax-m3, fireworks/kimi-k2.7-code). Optionally override the
# endpoint via FIREWORKS_BASE_URL (default https://api.fireworks.ai/inference).
FIREWORKS_API_KEY=...
# xAI auth token, used by Harbor's grok-build agent (e.g. --agent grok-build
# --model xai/redacted-model). The key is read from the runtime
# environment by Harbor and is not persisted in trial config.
XAI_API_KEY=...
# Meta auth token for mini-swe-agent evals on Meta's OpenAI-compatible API
# (e.g. --agent mini-swe-agent --model meta/<model>). Optionally override the
# endpoint via META_BASE_URL (default https://api.ai.meta.com/v1).
META_API_KEY=...
# Optional x-session-id controls. By default Oddish emits
# oddish-eval--<random-run-id>; set the eval name to get e.g.
# swe-marathon--<random-run-id>, or set a full session id explicitly.
# ODDISH_META_EVAL_NAME=SWE Marathon
# ODDISH_META_SESSION_ID=swe-marathon--123456

##### OpenAI-family routing
# Azure OpenAI is the default for Oddish worker and verdict calls.
# Map each requested Oddish/OpenAI model id to its Azure deployment name.
# Use an OpenAI-compatible endpoint such as *.openai.azure.com/openai/v1 or
# *.services.ai.azure.com/openai/v1. Do not use the Foundry project endpoint
# ending in /api/projects/<project>.
ODDISH_OPENAI_PROVIDER=azure
AZURE_OPENAI_API_KEY=...
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/openai/v1
AZURE_OPENAI_API_VERSION=...
ODDISH_AZURE_OPENAI_DEPLOYMENTS='{"openai/gpt-5.4":"azure-gpt-5-4","gpt-5.4":"azure-gpt-5-4"}'

# Public OpenAI is explicit opt-in only:
# ODDISH_OPENAI_PROVIDER=openai
# OPENAI_API_KEY=sk-...

##### Cloud sandboxes (optional)
DAYTONA_API_KEY=...
MODAL_TOKEN_ID=...
MODAL_TOKEN_SECRET=...

##### EC2 Harbor backend (optional, CPU-only)
# Opt in to one ephemeral public-IP EC2 instance per trial. EC2 is never chosen
# automatically: Daytona remains the hosted CPU default and callers select EC2
# explicitly with `oddish run --env ec2`. V1 requires operator-provided AWS
# networking, AMI, key pair, and credentials; Oddish creates none of them.
# ODDISH_EC2_ENABLED=true
# ODDISH_EC2_REGION=us-east-1
# ODDISH_EC2_AMI_ID=ami-...
# ODDISH_EC2_INSTANCE_TYPE=m7i-flex.large
# ODDISH_EC2_SUBNET_ID=subnet-...
# JSON list of existing security groups. TCP/22 must be reachable from workers.
# ODDISH_EC2_SECURITY_GROUP_IDS='["sg-..."]'
# Existing EC2 key-pair name and matching private key. Store the private key in
# the worker-only secret channel, not in a checked-in .env file.
# ODDISH_EC2_KEY_NAME=oddish-harbor
# ODDISH_EC2_SSH_USER=ubuntu
# ODDISH_EC2_SSH_PRIVATE_KEY="-----BEGIN OPENSSH PRIVATE KEY-----..."
# ODDISH_EC2_AWS_ACCESS_KEY_ID=...
# ODDISH_EC2_AWS_SECRET_ACCESS_KEY=...
# ODDISH_EC2_AWS_SESSION_TOKEN=...  # optional
# Optional platform-owned instance-profile name or ARN. This exposes that
# profile to sandbox code through IMDSv2, so grant only task-required actions.
# ODDISH_EC2_INSTANCE_PROFILE=oddish-harbor-sandbox
# ODDISH_EC2_ROOT_VOLUME_SIZE_GB=80
# ODDISH_EC2_USE_PUBLIC_IP=true
# ODDISH_EC2_BOOTSTRAP_DOCKER=true
# ODDISH_EC2_MAX_CONCURRENT_INSTANCES=16
# Oddish requires IMDSv2 with hop limit one so host cloud-init can fetch the
# launch SSH key. A configured profile raises the hop limit to two for Docker;
# control then needs iam:PassRole.
# Standalone worker hosts must install the OpenSSH client (`openssh-client` on
# Debian/Ubuntu); the shared backend Dockerfile and Modal image include it.

##### GKE TPU backend (optional)
# Runs TPU trials on a GKE Autopilot cluster. Set ODDISH_GKE_CLUSTER_NAME to
# register the backend and enable `oddish run --env gke`; tasks whose task.toml
# declares [environment.tpu] route here automatically. Deployment targets region
# us-east5 (zone us-east5-b), the only location with preemptible TPU v6e DWS
# flex-start capacity.
# ODDISH_GKE_CLUSTER_NAME=oddish-tpu
# ODDISH_GKE_REGION=us-east5
# ODDISH_GKE_PROJECT_ID=...
# Kubernetes namespace the trial pods run in (default oddish-trials).
# ODDISH_GKE_NAMESPACE=oddish-trials
# Artifact Registry the prebuilt trial images are pulled from.
# ODDISH_GKE_REGISTRY_LOCATION=us-east5
# ODDISH_GKE_REGISTRY_NAME=oddish-envs
# Opt into DWS flex-start capacity (default true) and how long a pod may stay
# Pending while its node is provisioned (seconds, default 3600).
# ODDISH_GKE_FLEX_START=true
# ODDISH_GKE_POD_READY_TIMEOUT_SEC=3600

##### Per-run container-registry login (optional, client-side)
# Supplied by whoever triggers a run so the trial sandbox's inner Docker daemon
# authenticates compose image pulls (avoids Docker Hub `toomanyrequests`). Read
# by `oddish run` and sent write-only with the submission; never stored in the
# trial config. Prefer a Docker Hub access token (PAT) over your password.
# Equivalent to: oddish run ... --registry-login username=USER,token=TOKEN
# ODDISH_DOCKERHUB_USERNAME=...
# ODDISH_DOCKERHUB_TOKEN=...

##### Registry-auth data key (optional, server-side)
# Fernet key that encrypts per-run registry tokens as they cross the queue. When
# unset, a key is derived from ODDISH_DATABASE_URL so encryption still applies.
# Set this to rotate independently of the database. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ODDISH_REGISTRY_AUTH_KEY=...

##### Queue concurrency (optional)
# Nop/oracle trials use the dedicated nop_oracle queue because they do not
# consume model-provider quota.
# ODDISH_NOP_ORACLE_CONCURRENCY=256

##### S3-compatible storage (required)
# ODDISH_S3_BUCKET=...
# ODDISH_S3_REGION=...
# ODDISH_S3_ACCESS_KEY=...
# ODDISH_S3_SECRET_KEY=y...
# ODDISH_S3_ENDPOINT_URL=...
