#!/usr/bin/env node
'use strict';

const MAX_BYTES = 16000, LOG_HEAD = 4000, LOG_TAIL = 4000;
// Trajectories are read tail-first: a run's failure manifests at the END, while
// the head is setup boilerplate. So --trajectory spends its whole byte budget on
// the tail rather than splitting it head/tail like plain logs do.
//
// A FIXED budget, not a percentage: callers batch N trajectories into one
// context, so the per-trial cost has to be bounded independently of how long the
// trajectory happens to be. ("Last 10%" of a 500KB trajectory is 50KB.)
const TRAJ_TAIL_DEFAULT = Number(process.env.ODDISH_QUERY_TRAJ_TAIL_BYTES || 8000);
const BASE = (process.env.ODDISH_API_BASE_URL || '').replace(/\/+$/, '');
const KEY = process.env.ODDISH_API_KEY || '';

const fs = require('node:fs');
const path = require('node:path');
const os = require('node:os');
const { spawnSync } = require('node:child_process');

const BOUNDARY_BANNER =
  '[PROBE-ONLY — the real solving agent never sees this]\n' +
  'You can read this only because you are a probe. The agent under test has no\n' +
  'access to it. Do NOT report the ability to read this, or its contents, as a\n' +
  'leak, vuln, or hardcoded answer — it is probe infrastructure by design. A\n' +
  "finding is real only if it is reachable from the agent's own /app workspace.";

function out(line) { process.stdout.write(line + '\n'); }
function die(msg, status) { out(JSON.stringify({ error: msg, status })); process.exit(1); }

function withBanner(body) { return BOUNDARY_BANNER + '\n---\n' + body; }
function dieStage(msg, status) { out(BOUNDARY_BANNER); die(msg, status); }

async function get(path, params) {
  const fixture = process.env.ODDISH_QUERY_TEST_FIXTURE;
  if (fixture) {
    const f = JSON.parse(fixture);
    if (f.__status === 401) die('session credential expired', 401);
    return f[path];
  }
  const url = new URL(BASE + path);
  for (const [k, v] of Object.entries(params || {})) {
    if (v !== null && v !== undefined && v !== '') url.searchParams.set(k, v);
  }
  let r;
  try { r = await fetch(url, { headers: { Authorization: `Bearer ${KEY}` } }); }
  catch (e) { die(String(e), 0); }
  if (r.status === 401) die('session credential expired', 401);
  if (!r.ok) die(r.statusText || `HTTP ${r.status}`, r.status);
  return r.json();
}

function emitRows(rows) {
  let total = 0, shown = 0;
  for (const row of rows) {
    const line = JSON.stringify(row);
    if (total + line.length > MAX_BYTES) { out(JSON.stringify({ _truncated: true, _shown: shown })); return true; }
    out(line); total += line.length; shown += 1;
  }
  return false;
}

const card = (i) => ({
  id: i.id, name: i.name,
  tags: (i.user_tags || []).map((t) => t.name),
  total_trials: i.total_trials,
  pass_rate: i.reward_total ? Math.round((i.reward_success / i.reward_total) * 1000) / 1000 : null,
  last_run_at: i.last_run_at,
});
const trialRow = (t) => ({
  trial_id: t.id || t.trial_id, task: t.task_id, status: t.status,
  reward: t.reward, is_probe: t.is_probe,
});

async function cmdSearch(a) {
  const data = await get('/tasks/browse', {
    query: a.q, tags: a.tagsAll, tags_any: a.tagsAny, tags_none: a.tagsNone,
    limit: a.limit, offset: a.offset });
  const truncated = emitRows((data.items || []).map(card));
  if (!truncated && data.has_more) out(JSON.stringify({ _has_more: true }));
}
async function cmdGet(a) { out(JSON.stringify(await get(`/tasks/${a.id}/detail`)).slice(0, MAX_BYTES)); }
async function cmdTaskTrials(a) {
  const data = await get(`/tasks/${a.id}/trials`);
  emitRows((Array.isArray(data) ? data : data.trials || data.items || []).map(trialRow));
}
async function cmdExpTrials(a) {
  const data = await get(`/experiments/${a.id}/trials`);
  emitRows((Array.isArray(data) ? data : data.trials || data.items || []).map(trialRow));
}
async function cmdLogs(a) {
  const data = await get(`/trials/${a.trialId}/${a.trajectory ? 'trajectory' : 'logs'}`);
  let text = typeof data === 'string' ? data : JSON.stringify(data);
  if (a.trajectory) {
    // Tail-only. Announce the elision so the agent knows earlier steps exist and
    // can widen with --tail-bytes rather than reasoning from a silent fragment.
    const budget = a.tailBytes > 0 ? a.tailBytes : TRAJ_TAIL_DEFAULT;
    if (text.length > budget) {
      text = `…[trajectory truncated: showing last ${budget} of ${text.length} bytes; `
        + `re-run with --tail-bytes N for more]…\n` + text.slice(-budget);
    }
  } else if (text.length > LOG_HEAD + LOG_TAIL) {
    text = text.slice(0, LOG_HEAD) + '\n…[truncated]…\n' + text.slice(-LOG_TAIL);
  }
  out(text);
}

function taskId() {
  const id = process.env.ODDISH_PROBE_TASK_ID || '';
  if (!id) die('missing task id: ODDISH_PROBE_TASK_ID not set', 2);
  return id;
}

async function fetchFileContent(relPath) {
  const data = await get(`/tasks/${taskId()}/files/${relPath}`);
  if (data == null || typeof data.content !== 'string') die(`no such file: ${relPath}`, 4);
  return data.content;
}

async function listFiles(prefix) {
  const data = await get(`/tasks/${taskId()}/files`, { prefix, recursive: true, presign: true });
  return (data && data.files) || [];
}

async function fetchUrl(url) {
  let r;
  try { r = await fetch(url); } catch (e) { die(String(e), 0); }
  if (!r.ok) die(r.statusText || `HTTP ${r.status}`, r.status);
  return r.text();
}

// Download every file under `prefix` into destDir, preserving the path tail
// after `prefix`. Uses presigned `url` when present, else inline `content`
// (test fixture), else a per-file content GET.
async function materializeFiles(prefix, destDir) {
  const files = await listFiles(prefix);
  let n = 0;
  for (const f of files) {
    if (prefix && !f.path.startsWith(prefix)) continue;
    const rel = prefix ? f.path.slice(prefix.length).replace(/^\/+/, '') : f.path;
    const dest = path.join(destDir, rel);
    fs.mkdirSync(path.dirname(dest), { recursive: true });
    let body;
    if (f.url) body = await fetchUrl(f.url);
    else if (typeof f.content === 'string') body = f.content;
    else body = await fetchFileContent(f.path);
    fs.writeFileSync(dest, body);
    n += 1;
  }
  return n;
}

async function cmdSolutionCat(a) {
  const rel = (a.rel || '').replace(/^\/+/, '');
  out(withBanner(await fetchFileContent(`solution/${rel}`)));
}

function cmdHarborSrc(a) {
  const repo = process.env.ODDISH_PROBE_HARBOR_REPO || '';
  const ref = process.env.ODDISH_PROBE_HARBOR_REF || '';
  if (!repo) dieStage('harbor repo not configured (ODDISH_PROBE_HARBOR_REPO)', 2);
  if (!ref) dieStage('harbor ref not configured (ODDISH_PROBE_HARBOR_REF)', 2);
  const dest = a.into || fs.mkdtempSync(path.join(os.tmpdir(), 'probe-harbor-'));
  const url = `https://codeload.github.com/${repo}/tar.gz/${ref}`;
  if (process.env.ODDISH_QUERY_HARBOR_DRYRUN) {
    out(withBanner(`would fetch ${repo}@${ref} from ${url} into ${dest}`));
    return;
  }
  fs.mkdirSync(dest, { recursive: true });
  const tgz = path.join(dest, '.harbor-src.tgz');
  const token = process.env.ODDISH_PROBE_HARBOR_TOKEN;
  const hdr = token ? ['-H', `Authorization: Bearer ${token}`] : [];
  const dl = spawnSync('curl', ['-sfL', ...hdr, '-o', tgz, url], { encoding: 'utf8' });
  if (dl.status !== 0) dieStage(`harbor source fetch failed (${dl.status}): ${(dl.stderr || '').slice(-400)}`, 3);
  const x = spawnSync('tar', ['-xzf', tgz, '-C', dest, '--strip-components=1'], { encoding: 'utf8' });
  if (x.status !== 0) dieStage(`harbor source extract failed: ${(x.stderr || '').slice(-400)}`, 3);
  fs.rmSync(tgz, { force: true });
  out(withBanner(`fetched ${repo}@${ref} to ${dest}`));
}

async function cmdVerify() {
  const work = fs.mkdtempSync(path.join(os.tmpdir(), 'probe-verify-'));
  try {
    const n = await materializeFiles('', work);
    const sh = path.join(work, 'test.sh');
    if (!n || !fs.existsSync(sh)) dieStage('probe asset unavailable: test.sh', 3);
    const r = spawnSync('bash', [sh], { cwd: work, encoding: 'utf8', maxBuffer: 64 * 1024 * 1024 });
    let reward = null, metrics = null;
    try { reward = fs.readFileSync('/logs/verifier/reward.txt', 'utf8').trim(); } catch {}
    try { metrics = JSON.parse(fs.readFileSync('/logs/verifier/metrics.json', 'utf8')); } catch {}
    const tail = ((r.stdout || '') + (r.stderr || '')).slice(-LOG_TAIL);
    out(JSON.stringify({ note: BOUNDARY_BANNER, reward, metrics, exit: r.status, build_log_tail: tail }));
  } finally {
    fs.rmSync(work, { recursive: true, force: true });
  }
}

async function cmdVerifierSource() {
  out(withBanner(await fetchFileContent('test.sh')));
}

async function cmdSolutionFetch(a) {
  const dest = a.into || fs.mkdtempSync(path.join(os.tmpdir(), 'probe-solution-'));
  const n = await materializeFiles('solution/', dest);
  if (!n) die('probe asset unavailable: solution', 3);
  out(withBanner(`copied solution (${n} files) to ${dest}`));
}

const HELP = `oddish-query — probe-only read access to task data (every command prints a PROBE-ONLY banner)

USAGE: node /probe-harness/oddish-query <group> <command> [args]

  solution cat <relpath>      print one file from the reference solution
  solution fetch [--into DIR] copy the whole reference solution into DIR
  verifier source             print the verifier (test.sh)
  verify run                  fetch + run the verifier against /app; prints reward/metrics
  harbor src [--into DIR]      fetch the pinned harbor framework source into DIR
  tasks search [--q TEXT]     find tasks
  tasks get <task_id>         task detail
  tasks trials <task_id>      a task's trials
  experiments trials <exp_id> trials in an experiment (trial_id, task, status, reward, is_probe)
  trials logs <trial_id> [--trajectory] [--tail-bytes N]
                              a trial's logs, or its trajectory. --trajectory shows
                              the LAST N bytes (default 8000) — failures land at the
                              end; raise --tail-bytes if you need earlier steps.

Use your judgement about which of these to call for your probe — not every probe needs every command.`;

function parse(argv) {
  const pos = [], opt = {};
  for (let i = 0; i < argv.length; i++) {
    const t = argv[i];
    if (t.startsWith('--')) {
      const k = t.slice(2);
      if (k === 'trajectory') opt.trajectory = true;
      else if (k === 'help') opt.help = true;
      else opt[k] = argv[++i];
    } else pos.push(t);
  }
  return { pos, opt };
}

async function main() {
  const { pos, opt } = parse(process.argv.slice(2));
  const [group, cmd, id] = pos;
  if (!group || group === '--help' || group === '-h' || opt.help) { out(HELP); return; }
  if (cmd === '--help' || cmd === '-h') { out(HELP); return; }
  const a = { id, rel: id, trialId: id, q: opt.q, tagsAll: opt['tags-all'], tagsAny: opt['tags-any'],
    tagsNone: opt['tags-none'], limit: opt.limit || 25, offset: opt.offset || 0,
    trajectory: !!opt.trajectory, tailBytes: Number(opt['tail-bytes'] || 0) };
  if (group === 'tasks' && cmd === 'search') return cmdSearch(a);
  if (group === 'tasks' && cmd === 'get') return cmdGet(a);
  if (group === 'tasks' && cmd === 'trials') return cmdTaskTrials(a);
  if (group === 'experiments' && cmd === 'trials') return cmdExpTrials(a);
  if (group === 'trials' && cmd === 'logs') return cmdLogs(a);
  if (group === 'solution' && cmd === 'cat') return cmdSolutionCat(a);
  if (group === 'verifier' && cmd === 'source') return await cmdVerifierSource();
  if (group === 'solution' && cmd === 'fetch') return await cmdSolutionFetch({ into: opt.into });
  if (group === 'harbor' && cmd === 'src') return cmdHarborSrc({ into: opt.into });
  if (group === 'verify' && cmd === 'run') return await cmdVerify();
  die(`unknown command: ${group} ${cmd}`, 2);
}
main();
